   add_executable(dot_x4_policy_test src/core/dot_x4_policy_test.cpp)
   target_include_directories(dot_x4_policy_test PRIVATE include)
   add_test(NAME dot_x4_policy_test COMMAND dot_x4_policy_test)
 
